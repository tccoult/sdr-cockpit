    "cmdk": "^1.1.1",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "fuse.js": "^7.1.0",
    "fzstd": "^0.1.1",
    "lucide-react": "^0.562.0",
    "openapi-fetch": "^0.15.0",
    "protobufjs": "^8.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.11.0",
