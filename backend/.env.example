# SDR Cockpit Backend Configuration

# CORS allowed origins (comma-separated)
# Default: http://localhost:3000,http://localhost:5173
SDR_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# Seed mock tasks on startup for testing/development
# Default: true
SDR_SEED_MOCK_TASKS=true

# Logging level (DEBUG, INFO, WARNING, ERROR)
# Default: INFO
LOG_LEVEL=INFO
